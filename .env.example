# --- Credenciales de Entra ID ----------------------------------------------
# App registrada con el permiso de aplicación Mail.Send de Microsoft Graph y
# consentimiento de administrador otorgado.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Correo ----------------------------------------------------------------
# Esta dirección es también el buzón desde el que Graph envía.
MAIL_FROM="Nombre Apellido <usuario@example.com>"
# Uno o varios destinatarios separados por coma
MAIL_TO=seguridad@example.com
MAIL_SUBJECT=Autorización de ingreso de audífonos

# Simulacro: arma el correo y lo muestra en consola, pero no lo envía.
# Útil para probar plantilla y horarios sin credenciales válidas.
MAIL_DRY_RUN=false

# --- Contenido de la plantilla ---------------------------------------------
EMPLOYEE_NAME=Nombre Apellido
EMPLOYEE_DEPARTMENT=Tecnología

# Datos del dispositivo. Los campos vacíos no aparecen en el correo.
DEVICE_TYPE=Audífonos personales
DEVICE_BRAND=
DEVICE_MODEL=
DEVICE_COLOR=
DEVICE_SERIAL=

# --- Programación ----------------------------------------------------------
# Formato cron de 5 campos: minuto hora día-del-mes mes día-de-semana
CRON_EXPRESSION=0 8 * * *
TIMEZONE=America/Monterrey

# Guarda anti-duplicados:
#   daily -> un envío exitoso por día calendario (default, para el cron diario)
#   off   -> sin guarda por día; úsalo si el cron dispara varias veces al día
DUPLICATE_GUARD=daily

# --- Opcional --------------------------------------------------------------
# Verificar el acceso a Graph al arrancar (no detiene el servicio si falla)
VERIFY_ON_STARTUP=true

# --- Bitácora (MongoDB) ------------------------------------------------------
# Opcional. Sin MONGODB_URI el servicio funciona igual, pero sin historial de
# envíos y con la guarda anti-duplicados solo en memoria.
MONGODB_URI=
MONGODB_DB=headphones_notifier
